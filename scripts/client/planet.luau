-- Planet.new(planetId, radius, position?) spawns a slowly rotating procedural pixel planet (see assets/shaders/planet.glsl).
-- Planets are generated by the shader from config (config/planets.luau), no per-planet image. Client only:
-- the engine asset calls run only when a function is called, so requiring this module on the server is harmless.
-- All colours come from the `palette` there (the 8-colour theme), so a planet cannot leave it.
local config = require("@scripts/config/planets")
local Linear = require("@scripts/client/linear")

local Planet = {}

local function paletteColor(name: string)
	local hex = config.palette[name]
	assert(hex, "Planet: colour '" .. tostring(name) .. "' is not in the planets config palette")
	return Linear.fromHex(hex)
end

local shader, texture

-- Tests set Planet.assets to a stub: the Luau CLI has no `engine` global.
local function assets() return Planet.assets or engine.assets end

-- Builds the material of one planet: its shader with the planet's seed, palette and rotation.
local function material(id: string, def, render)
	local r = render or config.planetRender
	shader = shader or assets().shader(r.shaderPath)
	texture = texture or assets().texture(r.texturePath)
	return assets().material({
		name = "planet." .. id,
		shader = shader,
		values = {
			seed = def.seed,
			pixels = def.pixels or r.pixels,
			size = r.size,
			octaves = r.octaves,
			timeSpeed = r.rotationSpeed,
			tilt = def.tilt,
			phase = def.phase,
			waterLevel = def.waterLevel,
			cloudCover = def.cloudCover,
			lightOrigin = r.light,
			lightBorders = r.lightBorders,
			land1 = paletteColor(def.land[1]),
			land2 = paletteColor(def.land[2]),
			land3 = paletteColor(def.land[3]),
			land4 = paletteColor(def.land[4]),
			water1 = paletteColor(def.water[1]),
			water2 = paletteColor(def.water[2]),
			cloud1 = paletteColor(def.cloud[1]),
			cloud2 = paletteColor(def.cloud[2]),
			rimWidth = def.rim and r.rimWidth or 0,
			rim1 = paletteColor(def.rim and def.rim[1] or "text"),
			rim2 = paletteColor(def.rim and def.rim[2] or "dim"),
		},
	})
end

-- Builds the entity description of any shader body (planet, asteroid, star, galaxy) from a look table `def`
-- (same fields as config.planets entries, plus optional pixels/layer). id must be unique per distinct look.
function Planet.fromDef(id: string, def, radius: number, position)
	local r = config.planetRender
	local scale = (radius * 2) / r.textureSize
	return {
		["rtype.Transform"] = { position = position or { x = 0, y = 0 }, scale = { x = scale, y = scale } },
		["rtype.SpriteRenderer"] = {
			texture = texture or assets().texture(r.texturePath),
			source = { x = 0, y = 0, z = r.textureSize, w = r.textureSize }, -- the whole texture: UV 0..1
			origin = { x = r.textureSize / 2, y = r.textureSize / 2 },
			material = material(id, def, r),
			layer = def.layer or -90,
		},
	}
end

-- planetId: a key of config.planets. radius: in world units. Returns the spawn command's entity description
-- table to pass to ctx.commands:spawn(); add components to it (e.g. a game component) before spawning if needed.
function Planet.new(planetId: string, radius: number, position)
	local def = config.planets[planetId]
	assert(def, "Planet.new: unknown planet '" .. tostring(planetId) .. "'")
	return Planet.fromDef(planetId, def, radius, position)
end

return Planet
